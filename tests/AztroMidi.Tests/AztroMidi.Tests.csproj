<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dependency-free test runner for the playback engine (no xUnit/NUnit download needed).
    Run with: "dotnet run (double dash)project tests/AztroMidi.Tests", see CONTRIBUTING.md
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\AztroMidi\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
