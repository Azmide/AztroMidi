<Window x:Class="AztroMidi.MiniPlayer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AztroMidi Mini" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Border x:Name="Shell" Margin="10" CornerRadius="16" Padding="12,10,12,12"
            BorderThickness="1" MouseLeftButtonDown="OnDrag">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0222830" Offset="0"/>
                <GradientStop Color="#F016191C" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#660BA6DF" Offset="0"/>
                <GradientStop Color="#22333941" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4FC8F2" Offset="0"/>
                                <GradientStop Color="#0A80AD" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Margin="7,0,0,0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                        <Run Text="Aztro"/><Run Text="Midi" Foreground="{StaticResource Brand}"/>
                    </TextBlock>
                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Padding="7,1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource InkMuted}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Idle" Margin="5,0,0,0" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandMuted}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SnapButton" Style="{StaticResource IconButton}" Width="24" Height="22" FontSize="10"
                            Content="&#xE718;" ToolTip="Stick to the top-right corner of Roblox" Click="OnSnap"/>
                    <Button Style="{StaticResource IconButton}" Width="24" Height="22" FontSize="10"
                            Content="&#xE740;" ToolTip="Open the full window" Click="OnExpand"/>
                </StackPanel>
            </Grid>

            <!-- Song -->
            <TextBlock x:Name="TitleText" Text="No song loaded" FontSize="13" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" Margin="0,8,0,6"/>

            <Grid>
                <Border Height="4" CornerRadius="2" Background="{StaticResource Surface3}"/>
                <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Background="{StaticResource Brand}"
                        HorizontalAlignment="Left" Width="0"/>
            </Grid>
            <Grid Margin="0,3,0,0">
                <TextBlock x:Name="PosText" Text="0:00" FontSize="10" Foreground="{StaticResource InkFaint}"/>
                <TextBlock x:Name="LenText" Text="0:00" FontSize="10" Foreground="{StaticResource InkFaint}" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Transport -->
            <Grid Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Width="32" Height="30" Padding="0" ToolTip="Previous" Click="OnPrev">
                        <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Width="44" Height="30" Padding="0"
                            Margin="5,0,0,0" ToolTip="Play / Pause" Click="OnPlay">
                        <TextBlock x:Name="PlayIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                    <Button Width="32" Height="30" Padding="0" Margin="5,0,0,0" ToolTip="Stop" Click="OnStop">
                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button Width="32" Height="30" Padding="0" Margin="5,0,0,0" ToolTip="Next" Click="OnNext">
                        <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="24" Height="30" Padding="0" Content="−" ToolTip="Slower" Click="OnSlower"/>
                    <TextBlock x:Name="SpeedText" Text="1.00x" Width="42" TextAlignment="Center" FontSize="11.5"
                               FontWeight="SemiBold" Foreground="{StaticResource BrandMuted}" VerticalAlignment="Center"/>
                    <Button Width="24" Height="30" Padding="0" Content="+" ToolTip="Faster" Click="OnFaster"/>
                </StackPanel>
            </Grid>

            <!-- Upcoming keys -->
            <Border Background="#66000000" CornerRadius="10" Padding="9,6" Margin="0,9,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="NEXT" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource InkFaint}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NextKeys" Grid.Column="1" Margin="8,0,0,0" FontFamily="Consolas" FontSize="13"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
