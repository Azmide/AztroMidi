<Window x:Class="AztroMidi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AztroMidi.Controls"
        Title="AztroMidi" Width="1120" Height="800" MinWidth="940" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="{StaticResource Base}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource UiFont}" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!--
        The top 60 px act as a real Windows title bar: drag to move, drag down from
        maximized to restore, double-click to maximize, Snap to screen edges.
        Interactive elements inside it opt out with IsHitTestVisibleInChrome.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="60" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Border Background="{StaticResource WindowGlow}" IsHitTestVisible="False"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ============ Title bar / navigation ============ -->
            <Border Grid.Row="0" Background="#CC14171A" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4FC8F2" Offset="0"/>
                                    <GradientStop Color="#0A80AD" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="17" FontWeight="Bold">
                            <Run Text="Aztro"/><Run Text="Midi" Foreground="{StaticResource Brand}"/>
                        </TextBlock>
                        <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Padding="8,2">
                            <TextBlock x:Name="VersionText" Text="v1.0" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrandMuted}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton x:Name="NavPlayer" Style="{StaticResource NavTab}" Content="Player" GroupName="Nav" IsChecked="True" Checked="OnNav"/>
                        <RadioButton x:Name="NavHumanize" Style="{StaticResource NavTab}" Content="Humanize" GroupName="Nav" Checked="OnNav"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavTab}" Content="Settings" GroupName="Nav" Checked="OnNav"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MiniButton" Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Mini player over Roblox (F7)" Click="OnMini"/>
                        <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" ToolTip="Always on top" Click="OnPin"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimize" Click="OnMinimize"/>
                        <Button x:Name="MaxButton" Style="{StaticResource IconButton}" Content="&#xE922;" ToolTip="Maximize" Click="OnMaximize"/>
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close" Click="OnClose"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Player page ============ -->
            <Grid x:Name="PagePlayer" Grid.Row="1" Margin="18,16,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="132"/>
                </Grid.RowDefinitions>

                <!-- Library -->
                <Border Style="{StaticResource Card}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Library"/>
                                <TextBlock x:Name="LibraryInfo" Style="{StaticResource Muted}" Text="No folder selected" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Choose songs folder" Click="OnPickFolder"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Open a MIDI file" Click="OnOpenFile"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Click="OnRefreshLibrary"/>
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="SearchBox" Grid.Row="1" Tag="Search songs..." TextChanged="OnSearch" Margin="0,0,0,8"/>
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Border Background="{StaticResource Surface2}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="FilterAll" Style="{StaticResource Segment}" Content="All songs" GroupName="Filter" IsChecked="True" Checked="OnFilterChanged"/>
                                    <RadioButton x:Name="FilterFav" Style="{StaticResource Segment}" GroupName="Filter" Checked="OnFilterChanged">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="Favorites" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="CountText" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ListBox x:Name="SongList" Grid.Row="3" SelectionChanged="OnSongSelected" MouseDoubleClick="OnSongDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="9" Background="{Binding TileBrush}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding TileGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{Binding TileInk}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Folder}" FontSize="10.5" Foreground="{StaticResource InkFaint}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12"
                                                Content="{Binding StarGlyph}" Foreground="{Binding StarBrush}" Tag="{Binding}"
                                                ToolTip="Favorite" Click="OnToggleFavorite"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="LibraryEmpty" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{StaticResource Surface3}" HorizontalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,10,0,0"
                                       Text="Pick a songs folder or drop .mid files anywhere on this window."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right column -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Now playing -->
                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="StatusPill" Style="{StaticResource Pill}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource InkMuted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StatusText" Text="Idle" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandMuted}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Caption}" Text="NOW PLAYING" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-30,0,0">
                                <TextBlock Style="{StaticResource Caption}" Text="SEND TO" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border x:Name="OutputHint" Background="{StaticResource Surface2}" CornerRadius="10" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="OutKeyboard" Style="{StaticResource Segment}" Content="Roblox" GroupName="Out" Checked="OnOutputChanged"
                                                     ToolTip="Real key presses. Pressing Play switches to Roblox for you."/>
                                        <RadioButton x:Name="OutPreview" Style="{StaticResource Segment}" Content="Preview" GroupName="Out" Checked="OnOutputChanged"
                                                     ToolTip="Listen to the song on this PC. Nothing is sent to Roblox."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="14" Margin="0,0,14,0" Effect="{StaticResource BrandGlow}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4FC8F2" Offset="0"/>
                                            <GradientStop Color="#0A80AD" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="&#xEC4F;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="SongTitle" Style="{StaticResource H1}" Text="No song loaded" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="SongMeta" Style="{StaticResource Muted}" Text="Choose a song from the library to get started."/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PosText" Text="0:00" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" Margin="4,0"
                                        PreviewMouseLeftButtonDown="OnProgressDown" PreviewMouseLeftButtonUp="OnProgressUp"/>
                                <TextBlock x:Name="LenText" Grid.Column="2" Text="0:00" Style="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Width="122" Height="40" Click="OnPlayPause">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="PlayIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PlayLabel" Text="Play" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Height="40" Width="44" Margin="8,0,0,0" ToolTip="Stop" Click="OnStop">
                                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                    </Button>
                                    <Button Height="40" Width="44" Margin="8,0,0,0" ToolTip="Previous song" Click="OnPrev">
                                        <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                    </Button>
                                    <Button Height="40" Width="44" Margin="8,0,0,0" ToolTip="Next song" Click="OnNext">
                                        <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                    </Button>
                                    <Border Width="1" Height="24" Background="{StaticResource Line}" Margin="12,0,4,0"/>
                                    <ToggleButton x:Name="QuickLoop" Style="{StaticResource IconToggle}" Height="40" Width="44" Margin="8,0,0,0"
                                                  Content="&#xE8ED;" ToolTip="Loop this song" Checked="OnQuickToggle" Unchecked="OnQuickToggle"/>
                                    <ToggleButton x:Name="QuickAutoNext" Style="{StaticResource IconToggle}" Height="40" Width="44" Margin="8,0,0,0"
                                                  Content="&#xE8EE;" ToolTip="Auto-play the next song" Checked="OnQuickToggle" Unchecked="OnQuickToggle"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Width="230" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Style="{StaticResource Caption}" Text="SPEED"/>
                                        <TextBlock x:Name="SpeedText" Style="{StaticResource Value}" Text="1.00x" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="2" Value="1" SmallChange="0.05" LargeChange="0.1"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OnSpeedChanged" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Quick controls -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Quick controls" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource Caption}" Text="TRANSPOSE" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Padding="0" Width="30" Height="30" Content="−" FontSize="14" Click="OnTransposeDown"/>
                                        <TextBlock x:Name="TransposeText" Text="0" Width="36" TextAlignment="Center" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource BrandMuted}" VerticalAlignment="Center"/>
                                        <Button Padding="0" Width="30" Height="30" Content="+" FontSize="14" Click="OnTransposeUp"/>
                                        <Button Margin="6,0,0,0" Padding="10,0" Height="30" Content="Auto" FontSize="11.5"
                                                ToolTip="Find the key that fits the most notes on the Roblox piano" Click="OnTransposeAuto"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource Caption}" Text="PIANO" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource Surface2}" CornerRadius="10" Padding="3" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Layout61" Style="{StaticResource Segment}" Content="61 keys" GroupName="Layout" Checked="OnLayoutChanged"/>
                                            <RadioButton x:Name="Layout88" Style="{StaticResource Segment}" Content="88 keys" GroupName="Layout" Checked="OnLayoutChanged"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <CheckBox x:Name="QuickHumanize" Style="{StaticResource Switch}" Content="Humanize"
                                          Checked="OnQuickHumanize" Unchecked="OnQuickHumanize"/>
                            </StackPanel>
                        </Border>

                        <!-- Tracks -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="2,0,0,8">
                                    <TextBlock Style="{StaticResource H2}" Text="Tracks"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Padding="10,4" FontSize="11" Content="All" Click="OnTracksAll"/>
                                        <Button Padding="10,4" FontSize="11" Content="None" Margin="6,0,0,0" Click="OnTracksNone"/>
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="TrackList" Grid.Row="1">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="10,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource InkFaint}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Padding="10,3" FontSize="10.5" Content="Solo" Tag="{Binding}" Click="OnSolo"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="TracksEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource Surface3}" HorizontalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,0"
                                               Text="Tracks of the loaded song show up here."/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Piano visualizer -->
                <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="12,10,12,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Caption}" Text="KEYBOARD" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Caption}" Text="NEXT" Margin="18,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NextKeysText" FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="KeyHint" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                       Text="Grey keys use Ctrl (88-key mode)"/>
                        </Grid>
                        <controls:PianoView x:Name="Piano" Grid.Row="1"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ Humanize page ============ -->
            <ScrollViewer x:Name="PageHumanize" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,16,18,8" MaxWidth="820">
                    <Border Style="{StaticResource Card}" Padding="22">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H1}" Text="Play like a human"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,120,0"
                                               Text="Real players are never perfectly on the grid. These settings add small, natural imperfections so playback sounds performed instead of robotic."/>
                                </StackPanel>
                                <CheckBox x:Name="HumanizeEnabled" Style="{StaticResource Switch}" Content="Enabled" FontWeight="SemiBold"
                                          HorizontalAlignment="Right" VerticalAlignment="Top" Checked="OnHumanizeEnabled" Unchecked="OnHumanizeEnabled"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Text="PRESETS" Margin="0,18,0,8"/>
                            <WrapPanel x:Name="PresetPanel"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0">
                        <StackPanel x:Name="HumanizeRows"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Settings page ============ -->
            <ScrollViewer x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,16,18,8" MaxWidth="820">
                    <Border Style="{StaticResource Card}" Padding="22">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H1}" Text="Playback"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8" Text="How notes are turned into key presses for the Roblox piano."/>
                            <StackPanel x:Name="PlaybackRows"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H1}" Text="Mini player"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8"
                                       Text="A small controller that floats over the corner of Roblox. Clicking it never steals focus from the game."/>
                            <StackPanel x:Name="MiniRows"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H1}" Text="Hotkeys"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8" Text="Global keys that work while Roblox is focused."/>
                            <StackPanel x:Name="HotkeyRows"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H1}" Text="About"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" x:Name="AboutText"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Status bar ============ -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#9914171A">
                <Grid Margin="18,0">
                    <TextBlock x:Name="HintText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    <TextBlock x:Name="HotkeyText" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="NoWrap"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
